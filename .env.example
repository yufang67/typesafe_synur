# Set these in your environment; this file is documentation, not auto-loaded.
SYNUR_MODEL_PROVIDER=typesafe
TYPESAFE_API_KEY=REPLACE_WITH_YOUR_KEY
TYPESAFE_MODEL=jev-1.13.0
# TYPESAFE_BASE_URL=https://api.typesafe.ai/

# Pi Scorer uses the SAME key variable and masked notebook prompt.
# Set SYNUR_MODEL_PROVIDER=pi-scorer and unset the external TYPESAFE_MODEL override.
# TYPESAFE_DEFAULT_MODEL=pi-scorer
# TYPESAFE_BASE_URL=https://pi-scoring.centralus.inference.ml.azure.com
# The Pi profile supplies both defaults when unset. /invocations is normalized
# to the host-only base URL; the official SDK posts to /v1/systemone.
# Never put an actual key in this file.
